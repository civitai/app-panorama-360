{
  "name": "panorama-360",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Civitai App (page money path) — generate seamless 360° equirectangular panoramas via customComfy and explore them in an embedded Photo Sphere Viewer.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node -e \"console.log('\\n✓ Installed. Next: npm run dev:harness   (preview — mock host, no Buzz)\\n  real seamless panoramas: npm run dev:orch (spends REAL Buzz, ~30-90/pano)   ·   publish: civitai app submit')\"",
    "dev": "vite",
    "dev:harness": "VITE_DEV_HARNESS=true VITE_HARNESS_MODE=mock vite --host 127.0.0.1 --port 5187",
    "dev:orch": "VITE_DEV_HARNESS=true VITE_HARNESS_MODE=orch vite --host 127.0.0.1 --port 5187",
    "dev:live": "VITE_DEV_HARNESS=true VITE_HARNESS_MODE=live vite --host 127.0.0.1 --port 5187",
    "dev:tunnel": "CIVITAI_DEV_TUNNEL_HMR=1 vite --host 127.0.0.1 --port 5187 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && npm run typecheck:kit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck:kit",
    "typecheck:kit": "tsc -p packages/comfy-run-kit/tsconfig.json --noEmit",
    "build:kit": "npm run build -w @civitai/comfy-run-kit",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@civitai/app-sdk": "^0.14.0",
    "@civitai/comfy-run-kit": "file:packages/comfy-run-kit",
    "@civitai/blocks-react": "^0.18.0",
    "@photo-sphere-viewer/core": "^5.11.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
