{
  "$schema": "https://civitai.com/schemas/app-block/v1.json",
  "blockId": "panorama-360",
  "version": "0.1.3",
  "name": "360° Panorama Studio",
  "tagline": "Generate a world, not a picture.",
  "category": "generation",
  "type": "block",
  "scopes": ["ai:write:budgeted"],
  "page": {
    "path": "/",
    "title": "360° Panorama Studio",
    "icon": "camera",
    "buzzBudgetPerGen": 200
  },
  "iframe": {
    "minHeight": 700,
    "maxHeight": 4000,
    "resizable": true,
    "sandbox": "allow-scripts allow-forms"
  },
  "contentRating": "g",
  "minApiVersion": "1.0",
  "buildCommand": "npm run build",
  "outputDir": "dist"
}
